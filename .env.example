# Salin ke .env.local untuk pengembangan lokal. Di produksi, isi lewat Vercel → Settings → Environment Variables.
# Jangan pernah commit nilai asli.

# Supabase kantor (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://wjbyrbbqumqpbqhkdpus.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Alamat aplikasi (dipakai di QR, link email, dan Telegram)
APP_BASE_URL=https://tiket.apotekalpro.id

# Foto: Web App Google Apps Script (apps-script/Code.gs). Lihat docs/PANDUAN_GOOGLE.md bagian B.
DRIVE_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
DRIVE_SCRIPT_SECRET=

# Email: Gmail gratis + App Password. Lihat docs/PANDUAN_GOOGLE.md bagian A.
SMTP_USER=apotekalpro.master@gmail.com
SMTP_PASS=
MAIL_OPS_TO=operation@apotekalpro.id
# Opsional (bawaan sudah benar untuk Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Tiket Fasilitas HQ <apotekalpro.master@gmail.com>

# Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Turnstile (anti-spam, opsional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron (string acak panjang)
CRON_SECRET=

# Garam hash IP untuk rate-limit (string acak, opsional)
IP_HASH_SALT=
